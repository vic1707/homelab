# renovate: datasource=github-tags depName=openwrt/openwrt extractVersion=^v(?<version>\d+\.\d+\.\d+)$
OPENWRT_VERSION=25.12.5
OPENWRT_TARGET=x86
OPENWRT_SUBTARGET=64
OPENWRT_PROFILE=generic
OPENWRT_BASE=router
OPENWRT_HOSTNAME=fedex
OPENWRT_ADD_PACKAGES="adguardhome avahi-nodbus-daemon blkid losetup luci-app-nlbwmon luci-ssl nut-driver-usbhid-ups nut-upsmon parted resize2fs"
OPENWRT_REMOVE_PACKAGES=""
OPENWRT_DISABLED_SERVICES="adguardhome"
OPENWRT_SSH_PUBLIC_KEY=.ssh-keys/fedex.pub
OPENWRT_EXPAND_ROOT=1
# Notes:
# parted losetup resize2fs blkid: https://openwrt.org/docs/guide-user/advanced/expand_root#automated_post_2512
