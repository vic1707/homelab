---
http:
    pprof:
        port: 6060
        enabled: false
    address: "{{ mgmt_network.gateway }}:3000"
    session_ttl: 720h
    doh:
        routes:
            - GET /dns-query
            - POST /dns-query
            - GET /dns-query/{ClientID}
            - POST /dns-query/{ClientID}
        insecure_enabled: false
users:
    - name: "{{ adguardhome.username }}"
      password: "{{ adguardhome.password | bcrypt_hash(inventory_hostname, 12) }}"
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: en
theme: auto
dns:
    bind_hosts:
        - 127.0.0.1
        - 192.168.255.1
{% for network in fedex_networks %}
        - "{{ network.gateway }}"
{% endfor %}
    port: 53
    anonymize_client_ip: false
    ratelimit: 0
    ratelimit_subnet_len_ipv4: 24
    ratelimit_subnet_len_ipv6: 56
    ratelimit_whitelist: []
    refuse_any: true
    upstream_dns:
        - "[/lan/]127.0.0.1:5353"
        - https://dns.quad9.net/dns-query
    upstream_dns_file: ""
    bootstrap_dns:
        - 9.9.9.9
        - 149.112.112.112
    fallback_dns: []
    upstream_mode: load_balance
    fastest_timeout: 1s
    allowed_clients:
        - 127.0.0.0/8
        - 192.168.255.0/24
{% for network in fedex_networks %}
        - "{{ network.subnet }}"
{% endfor %}
    disallowed_clients: []
    blocked_hosts: []
    trusted_proxies:
        - 127.0.0.0/8
        - ::1/128
    cache_enabled: true
    cache_size: 4194304
    cache_ttl_min: 0
    cache_ttl_max: 0
    cache_optimistic: false
    cache_optimistic_answer_ttl: 30s
    cache_optimistic_max_age: 12h
    bogus_nxdomain: []
    aaaa_disabled: false
    enable_dnssec: true
    edns_client_subnet:
        custom_ip: ""
        enabled: false
        use_custom: false
    max_goroutines: 300
    handle_ddr: false
    ipset: []
    ipset_file: ""
    bootstrap_prefer_ipv6: false
    upstream_timeout: 10s
    private_networks:
        - 127.0.0.0/8
        - 192.168.255.0/24
{% for network in fedex_networks %}
        - "{{ network.subnet }}"
{% endfor %}
    use_private_ptr_resolvers: true
    local_ptr_upstreams:
        - 127.0.0.1:5353
    use_dns64: false
    dns64_prefixes: []
    serve_http3: false
    use_http3_upstreams: false
    serve_plain_dns: true
    hostsfile_enabled: true
    pending_requests:
        enabled: true
tls:
    enabled: false
    server_name: ""
    force_https: false
    port_https: 0
    port_dns_over_tls: 0
    port_dns_over_quic: 0
    port_dnscrypt: 0
    dnscrypt_config_file: ""
    certificate_chain: ""
    private_key: ""
    certificate_path: ""
    private_key_path: ""
    strict_sni_check: false
querylog:
    dir_path: ""
    ignored: []
    interval: 24h
    size_memory: 1000
    enabled: true
    ignored_enabled: false
    file_enabled: true
statistics:
    dir_path: ""
    ignored: []
    interval: 168h
    enabled: true
    ignored_enabled: false
filters:
    - enabled: true
      url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/pro.txt
      name: HaGeZi Multi PRO
      id: 1
whitelist_filters: []
user_rules:
    - "||fedex.lan^$client=192.168.255.0/24,dnsrewrite=NOERROR;A;{{ mgmt_network.gateway }}"
{% for network in fedex_networks %}
    - "||fedex.lan^$client={{ network.subnet }},dnsrewrite=NOERROR;A;{{ mgmt_network.gateway }}"
{% endfor %}
filtering:
    protection_enabled: true
    filtering_enabled: true
    filters_update_interval: 24
    blocking_mode: default
    blocked_response_ttl: 10
    rewrites_enabled: true
    parental_enabled: false
    safebrowsing_enabled: false
dhcp:
    enabled: false
clients:
    runtime_sources:
        whois: false
        arp: true
        rdns: true
        dhcp: true
        hosts: true
    persistent: []
log:
    enabled: true
    file: ""
    max_backups: 0
    max_size: 100
    max_age: 3
    compress: false
    local_time: false
    verbose: false
os:
    group: ""
    user: ""
    rlimit_nofile: 0
schema_version: 34
