{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"timezone": "Europe/Paris",
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^devices/[^/]+/(openwrt\\.env|install\\.sh)$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>[\\w.-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))? extractVersion=(?<extractVersion>[^\\n]+)\\n(?:OPENWRT_VERSION|VERSION)=(?<currentValue>[^\\s]+)"
			]
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^devices/tv/settings\\.yml$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>[\\w.-]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))? extractVersion=(?<extractVersion>[^\\n]+)\\n\\s+version: \\\"(?<currentValue>[^\\\"]+)\\\""
			]
		}
	],
	"customDatasources": {
		"apkmirror": {
			"defaultRegistryUrlTemplate": "https://www.apkmirror.com/apk/{{packageName}}/",
			"format": "html"
		}
	},
	"packageRules": [
		{
			"matchManagers": ["docker-compose", "dockerfile"],
			"groupName": "Container images"
		},
		{
			"matchManagers": ["github-actions"],
			"groupName": "GitHub Actions"
		},
		{
			"matchManagers": ["mise", "ansible-galaxy", "pip_requirements", "pep621"],
			"groupName": "Tools"
		},
		{
			"matchDepNames": ["openwrt/openwrt"],
			"groupName": "OpenWrt firmware"
		}
	]
}
